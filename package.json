{
  "name": "ecu-hardware-copilot",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.offline.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist-offline',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "npm run typecheck:core && vitest run tests && npm run test:policy",
    "test:policy": "node --experimental-strip-types scripts/verify-autohw-core.ts && node scripts/verify-autohw-core-policy.cjs && node --experimental-strip-types scripts/verify-phase4.ts && node scripts/verify-phase5-navigation.cjs && node --experimental-strip-types scripts/verify-phase5-route.cjs && node scripts/verify-phase6-content.cjs && node --experimental-strip-types scripts/verify-phase7-versioning.ts && node --experimental-strip-types scripts/verify-phase8-ai.ts && node scripts/verify-phase8-ai.cjs && node scripts/verify-phase9-selfcheck.cjs && node --experimental-strip-types scripts/verify-phase10-physics.ts",
    "test:vitest": "vitest run tests",
    "test:phase4": "node --experimental-strip-types scripts/verify-phase4.ts",
    "test:phase5": "node scripts/verify-phase5-navigation.cjs && node --experimental-strip-types scripts/verify-phase5-route.cjs",
    "test:phase6": "node scripts/verify-phase6-content.cjs",
    "test:phase7": "node --experimental-strip-types scripts/verify-phase7-versioning.ts",
    "test:phase8": "node --experimental-strip-types scripts/verify-phase8-ai.ts && node scripts/verify-phase8-ai.cjs",
    "test:phase9": "node scripts/verify-phase9-selfcheck.cjs",
    "lint:core": "eslint \"src/core/**/*.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite-plugin-singlefile": "^2.3.3",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
