{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/app/**/*.ts",
    "src/content/**/*.ts",
    "src/fixtures/**/*.ts"
  ],
  "exclude": [
    "legacy",
    "node_modules"
  ]
}
